{
  "name": "tikobox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "csp:print": "tsx -e \"import('./src/utils/csp.ts').then(m=>console.log(m.cspString()))\"",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:test": "node scripts/docs/test-examples.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
